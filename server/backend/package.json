{
  "name": "mbs-survey-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ម.ប.ស. Student Survey Analytics API",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:migrate": "ts-node -T src/etl/migrate.ts",
